  {
    "$project": {
      "objectId": 1,
      "candidate.ra": 1,
      "candidate.dec": 1,
      "candidate.jd": 1,
      "candidate.band": 1,
      "candidate.magap": 1,
      "nuclear_sep_arcsec": 1,
      "properties.episode_history.n_episodes": 1,
      "properties.episode_history.longest_quiet_days": 1,
      "lc": {
        "$map": {
          "input": {
            "$filter": {
              "input": {
                "$concatArrays": [
                  {
                    "$ifNull": [
                      "$prv_candidates",
                      []
                    ]
                  },
                  [
                    "$candidate"
                  ]
                ]
              },
              "cond": {
                "$and": [
                  {
                    "$isNumber": "$$this.magap"
                  },
                  {
                    "$gt": [
                      "$$this.magap",
                      0
                    ]
                  },
                  {
                    "$gte": [
                      "$$this.snr",
                      5
                    ]
                  }
                ]
              }
            }
          },
          "in": {
            "jd": {
              "$toDouble": "$$this.jd"
            },
            "band": "$$this.band",
            "mag": {
              "$toDouble": "$$this.magap"
            }
          }
        }
      },
      "annotations": {
        "nuclear_sep_arcsec": {
          "$round": [
            "$nuclear_sep_arcsec",
            3
          ]
        },
        "snr": {
          "$round": [
            "$candidate.snr",
            1
          ]
        },
        "reliability": {
          "$round": [
            "$candidate.reliability",
            3
          ]
        },
        "n_det_5sigma": "$n_det_5sigma",
        "age_days": {
          "$round": [
            {
              "$subtract": [
                "$candidate.jd",
                "$jd_min_prv"
              ]
            },
            2
          ]
        },
        "gaia_sep_now_arcsec": {
          "$round": [
            "$gaia_nearest.sep",
            2
          ]
        }
      }
    }
