                            6
                          ]
                        },
                        {
                          "$lte": [
                            "$$this.mag_white",
                            17.5
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "Gaia_High_PM_SNR3": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.Gaia_DR3",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$gt": [
                    "$$this.pm",
                    3
                  ]
                },
                {
                  "$gt": [
                    {
                      "$divide": [
                        "$$this.pm",
                        {
                          "$sqrt": {
                            "$add": [
                              {
                                "$pow": [
                                  "$$this.pmra_error",
                                  2
                                ]
                              },
                              {
                                "$pow": [
                                  "$$this.pmdec_error",
                                  2
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    5
                  ]
                },
                {
                  "$lt": [
                    {
                      "$abs": {
                        "$subtract": [
                          "$candidate.ra",
                          "$$this.ra"
                        ]
                      }
                    },
                    0.000277778
                  ]
                },
                {
                  "$lt": [
                    {
                      "$abs": {
                        "$subtract": [
                          "$candidate.dec",
                          "$$this.dec"
                        ]
                      }
                    },
                    0.000277778
                  ]
                },
                {
                  "$lte": [
                    "$$this.phot_g_mean_mag",
                    19.5
                  ]
                }
              ]
            }
          }
        }
      },
      "Is_Quasar": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.milliquas_v8",
                []
