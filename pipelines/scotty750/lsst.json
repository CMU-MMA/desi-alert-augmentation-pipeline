  {
    "$project": {
      "objectId": 1,
      "candidate.ra": 1,
      "candidate.dec": 1,
      "candidate.jd": 1,
      "candidate.band": 1,
      "candidate.magpsf": 1,
      "nuclear_sep_arcsec": 1,
      "properties.episode_history.n_episodes": 1,
      "properties.episode_history.longest_quiet_days": 1,
      "lc": {
        "$map": {
          "input": {
            "$filter": {
              "input": {
                "$concatArrays": [
                  {
                    "$ifNull": [
                      "$prv_candidates",
                      []
                    ]
                  },
                  [
                    "$candidate"
                  ]
                ]
              },
              "cond": {
                "$and": [
                  {
                    "$eq": [
                      "$$this.isdiffpos",
                      true
                    ]
                  },
                  {
                    "$isNumber": "$$this.magpsf"
                  },
                  {
                    "$gt": [
                      "$$this.magpsf",
                      0
                    ]
                  }
                ]
              }
            }
          },
          "in": {
            "jd": {
              "$toDouble": "$$this.jd"
            },
            "band": "$$this.band",
            "mag": {
              "$toDouble": "$$this.magpsf"
            }
          }
        }
      },
      "annotations": {
        "nuclear_sep_arcsec": {
          "$round": [
            "$nuclear_sep_arcsec",
            3
          ]
        },
        "reliability": {
          "$round": [
            "$candidate.reliability",
            3
          ]
        },
        "extendedness": {
          "$round": [
            "$candidate.extendedness",
            3
          ]
        },
        "ndethist": "$candidate.ndethist",
        "age_days": {
          "$round": [
            {
              "$subtract": [
                "$candidate.jd",
                "$jd_min_prv"
              ]
            },
            2
          ]
        }
      }
    }
