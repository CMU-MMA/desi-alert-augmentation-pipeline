                  ]
                },
                {
                  "$or": [
                    {
                      "$and": [
                        {
                          "$lte": [
                            "$$this.distance_arcsec",
                            4
                          ]
                        },
                        {
                          "$lte": [
                            "$$this.mag_white",
                            18
                          ]
                        }
                      ]
                    },
                    {
                      "$and": [
                        {
