                    "$candidate.jd",
                    "$$this.jd"
                  ]
                },
                0.2
              ]
            }
          }
        }
      },
      "TwoMass_Red_Star_IR_v2": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.2MASS_PSC",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$lte": [
                    {
                      "$sqrt": {
                        "$add": [
                          {
                            "$pow": [
                              {
                                "$abs": {
                                  "$subtract": [
                                    "$candidate.ra",
                                    "$$this.ra"
                                  ]
                                }
                              },
                              2
                            ]
                          },
                          {
                            "$pow": [
                              {
                                "$abs": {
                                  "$subtract": [
                                    "$candidate.dec",
                                    "$$this.dec"
                                  ]
                                }
                              },
                              2
                            ]
                          }
                        ]
                      }
                    },
                    0.00027
                  ]
                },
                {
                  "$gt": [
                    {
                      "$subtract": [
                        "$$this.h_m",
                        "$$this.k_m"
                      ]
                    },
                    -0.2
                  ]
                },
                {
                  "$lt": [
                    {
                      "$subtract": [
                        "$$this.h_m",
                        "$$this.k_m"
                      ]
                    },
                    0.4
                  ]
                },
                {
                  "$lt": [
                    {
                      "$subtract": [
                        "$$this.j_m",
                        "$$this.k_m"
                      ]
                    },
                    0.6
                  ]
                }
              ]
            }
          }
        }
      }
    }
