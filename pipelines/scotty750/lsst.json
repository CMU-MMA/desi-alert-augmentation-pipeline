          "candidate.pixelFlags_streak": {
            "$eq": false
          }
        },
        {
          "candidate.glint_trail": {
            "$eq": false
          }
        },
        {
          "$or": [
            {
              "coordinates.b": {
                "$gte": 7
              }
            },
            {
              "coordinates.b": {
                "$lte": -7
              }
            }
          ]
        },
        {
          "properties.star": {
            "$eq": false
          }
        }
      ]
    }
