  {
    "$addFields": {
      "nuclear_sep_arcsec": {
        "$min": {
          "$map": {
            "input": {
              "$filter": {
                "input": {
                  "$ifNull": [
                    "$cross_matches.LSPSC",
                    []
                  ]
                },
                "cond": {
                  "$not": [
                    {
                      "$gte": [
                        "$$this.score",
                        0.7
                      ]
                    }
                  ]
                }
              }
            },
            "in": "$$this.distance_arcsec"
          }
        }
      }
    }
  },
  {
    "$match": {
      "nuclear_sep_arcsec": {
        "$gte": 0,
        "$lte": 0.3
      }
    }
  },
  {
    "$addFields": {
